# =============================================================================
# SARTrader — VPS Environment Variables
# =============================================================================
# Copy this file to /home/sartrader/trading-bot/.env on the VPS
# Fill in your M-Stock credentials (see config.py for reference)
# =============================================================================

# ── Trading Mode ─────────────────────────────────────────────────────────────
# "PAPER" = paper trading (no real orders)
# "LIVE"  = real orders via M-Stock API
MODE=PAPER

# ── M-Stock API Credentials ──────────────────────────────────────────────────
# Get these from your M-Stock account → API Settings
MSTOCK_API_KEY=your_api_key_here
MSTOCK_TOTP_SECRET=your_32_char_totp_secret_here
# Access token is fetched fresh on each engine start (TOTP required daily for LIVE mode)

# ── Dashboard (optional overrides) ───────────────────────────────────────────
# DASHBOARD_PORT=8765
# WEBSOCKET_PORT=8766
# TICK_INTERVAL=5
